<?xml version="1.0"?>
<sdf version="1.7">
  <world name="greenhouse">
    <!-- Physics -->
    <physics type="ode">
      <real_time_factor>1.0</real_time_factor>
      <max_step_size>0.001</max_step_size>
    </physics>

    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="ignition-gazebo-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors" />
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands" />

    <!-- Sunlight for Gazebo Sim. Avoids depending on an external model://sun asset. -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Optional: Remove default flat ground plane if z-fighting occurs -->
    <model name="my_floor">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>40 40 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>40 40 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.46 0.44 1</ambient>
            <diffuse>0.58 0.59 0.56 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Shelf 1 -->
    <include>
      <name>shelf_1</name>
      <uri>model://greenhouse_shelf</uri>
      <pose>0.0 0.0 0.0 0 0 0</pose>
    </include>

    <!-- Shelf 2 -->
    <include>
      <name>shelf_2</name>
      <uri>model://greenhouse_shelf_metal</uri>
      <pose>0.0 2.5 0.0 0 0 0</pose>
    </include>

    <!-- Shelf 3 -->
    <include>
      <name>shelf_3</name>
      <uri>model://greenhouse_shelf</uri>
      <pose>0.0 5 0.0 0 0 0</pose>
    </include>


    <!-- Shelf 4 -->
    <include>
      <name>shelf_4</name>
      <uri>model://greenhouse_shelf_metal</uri>
      <pose>0.0 -2.5 0.0 0 0 0</pose>
    </include>

    <!-- North wall -->
    <model name="bbox_north">
      <static>true</static>
      <pose>0 7.325 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>34.1 0.1 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>34.1 0.1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="bbox_south">
      <static>true</static>
      <pose>0 -4.825 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>34.1 0.1 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>34.1 0.1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="bbox_east">
      <static>true</static>
      <pose>17.05 1.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 12.15 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 12.15 1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="bbox_west">
      <static>true</static>
      <pose>-17.05 1.25 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 12.15 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 12.15 1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
