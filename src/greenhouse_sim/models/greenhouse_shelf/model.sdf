<?xml version="1.0"?>
<sdf version="1.7">
  <model name="greenhouse_shelf">

    <!-- Shelf won't move -->
    <static>true</static>

    <link name="shelf_link">

      <!-- Original visual mesh, with Gazebo Sim color fallback. -->
      <visual name="shelf_visual">
        <geometry>
          <mesh>
            <uri>model://greenhouse_shelf/meshes/greenhouse_shelf.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.58 0.39 0.22 1</ambient>
          <diffuse>0.72 0.49 0.28 1</diffuse>
          <specular>0.08 0.06 0.04 1</specular>
        </material>
      </visual>

      <!-- Collision mesh -->
      <collision name="shelf_collision">
        <geometry>
          <mesh>
            <uri>model://greenhouse_shelf/meshes/greenhouse_shelf.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>

    </link>

  </model>
</sdf>
