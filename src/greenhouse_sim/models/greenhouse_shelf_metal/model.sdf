<?xml version="1.0"?>
<sdf version="1.7">
  <model name="greenhouse_shelf_metal">

    <!-- Shelf won't move -->
    <static>true</static>

    <link name="shelf_link">

      <!-- Original visual mesh, with Gazebo Sim color fallback. -->
      <visual name="shelf_visual">
        <geometry>
          <mesh>
            <uri>model://greenhouse_shelf/meshes/greenhouse_shelf.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.42 0.44 0.45 1</ambient>
          <diffuse>0.68 0.70 0.70 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>
      </visual>

      <!-- Collision mesh -->
      <collision name="shelf_collision">
        <geometry>
          <mesh>
            <uri>model://greenhouse_shelf/meshes/greenhouse_shelf.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>

    </link>

  </model>
</sdf>
