<?xml version="1.0"?>
<model>
  <name>aruco_marker</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>ur5e_visual_servo_sim</name>
  </author>
  <description>
    Flat ArUco marker (OpenCV DICT_4X4_50, id 0) on a thin plate, for use as a
    pose target in eye-in-hand visual servoing demos. The textured faces are
    the +/-x faces, so place it with its -x face toward the robot.
  </description>
</model>
