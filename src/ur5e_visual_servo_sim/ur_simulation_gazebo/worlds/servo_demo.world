<?xml version="1.0"?>
<!--
  Visual-servoing demo world.

  A single ArUco marker (DICT_4X4_50, id 0) on a thin plate, placed ~0.6 m in
  front of the robot base with its textured face toward the arm, under flat,
  even lighting so the marker is detected reliably from the wrist camera.

  Load it with:
    ros2 launch ur_simulation_gazebo ur_sim_control.launch.py \
      world:=$(ros2 pkg prefix ur_simulation_gazebo)/share/ur_simulation_gazebo/worlds/servo_demo.world

  If the marker is not in the camera view at startup, nudge the <pose> below
  (x = distance in front, z = height) or change the robot's initial_positions.
-->
<sdf version="1.6">
  <world name="default">

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Bright, even lighting: high ambient + no shadows keeps the vertical
         marker face well lit (and is cheaper on CPU/software rendering). -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Key light angled from the robot side so it falls on the marker's
         -x face rather than grazing it like the top-down sun. -->
    <!-- <light name="marker_key_light" type="directional"> -->
    <!--   <pose>0 0 2 0 0 0</pose> -->
    <!--   <diffuse>0.8 0.8 0.8 1</diffuse> -->
    <!--   <specular>0.05 0.05 0.05 1</specular> -->
    <!--   <direction>0.6 0.0 -0.4</direction> -->
    <!--   <cast_shadows>false</cast_shadows> -->
    <!-- </light> -->

    <!-- The marker. -x face points back toward the robot at the origin. -->
    <include>
      <name>aruco_marker</name>
      <uri>model://aruco_marker</uri>
      <pose>0.0 1.0 0.85 0.0 0 1.57</pose>
    </include>


  </world>
</sdf>
